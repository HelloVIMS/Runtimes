+import { describe, expect, it } from 'vitest';
+
+import { getGatewayProviderRegistration } from './gateway-provider-registry.js';
+import { containerAnthropicUrl, readVimsGatewaySettings, VIMS_GATEWAY_KIND, vimsContribution } from './vims.js';
+
+describe('VIMS gateway provider', () => {
+  it('rewrites loopback to the container host and keeps the route', () => {
+    expect(containerAnthropicUrl('http://127.0.0.1:8089/api/anthropic/')).toBe(
+      'http://host.docker.internal:8089/api/anthropic',
+    );
+    expect(containerAnthropicUrl('http://localhost:8089/api/anthropic')).toBe(
+      'http://host.docker.internal:8089/api/anthropic',
+    );
+    expect(containerAnthropicUrl('https://vims.example:8443/api/anthropic')).toBe(
+      'https://vims.example:8443/api/anthropic',
+    );
+  });
+
+  it('routes models through VIMS with only the scoped VIMS token', () => {
+    const c = vimsContribution({ anthropicUrl: 'http://127.0.0.1:8089/api/anthropic', token: 'tok' });
+    expect(c.env).toEqual({
+      ANTHROPIC_BASE_URL: 'http://host.docker.internal:8089/api/anthropic',
+      ANTHROPIC_AUTH_TOKEN: 'tok',
+      NO_PROXY: 'host.docker.internal',
+      no_proxy: 'host.docker.internal',
+    });
+    expect(c.networkAccess).toEqual({ endpoint: 'host.docker.internal', target: { kind: 'host' } });
+  });
+
+  it('fails closed without settings', () => {
+    expect(() => readVimsGatewaySettings({})).toThrow(/NANOCLAW_VIMS_ANTHROPIC_URL/);
+    expect(
+      readVimsGatewaySettings({
+        NANOCLAW_VIMS_ANTHROPIC_URL: 'http://127.0.0.1:1/a',
+        NANOCLAW_VIMS_GATEWAY_TOKEN: 't',
+      }),
+    ).toEqual({ anthropicUrl: 'http://127.0.0.1:1/a', token: 't' });
+  });
+
+  it('registers and holds the approval stream open until aborted', async () => {
+    const def = getGatewayProviderRegistration(VIMS_GATEWAY_KIND);
+    expect(def).toBeDefined();
+    const ctrl = new AbortController();
+    let done = false;
+    const p = def!.approvals.subscribe(async () => 'deny', ctrl.signal).then(() => (done = true));
+    await new Promise((r) => setTimeout(r, 20));
+    expect(done).toBe(false);
+    ctrl.abort();
+    await p;
+    expect(done).toBe(true);
+  });
+});

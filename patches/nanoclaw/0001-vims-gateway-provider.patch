@@ -0,0 +1,79 @@
+/**
+ * VIMS as NanoClaw's credential gateway.
+ *
+ * When VIMS launches NanoClaw it owns model access: every agent container
+ * reaches models only through the VIMS daemon's Anthropic-compatible route,
+ * authenticated with this instance's scoped VIMS gateway token. VIMS picks
+ * the model (local vLLM or a cloud key held in its Key Manager), so no
+ * provider credential ever enters a container.
+ *
+ * VIMS holds no requests for human approval, so the approval stream stays
+ * open, idle, until the host ends it.
+ */
+import { readEnvFile } from '../env.js';
+import { log } from '../log.js';
+import {
+  registerGatewayProvider,
+  type GatewayContribution,
+  type GatewaySessionInput,
+  type GatewaySessionLease,
+} from './gateway-provider-registry.js';
+
+export const VIMS_GATEWAY_KIND = 'vims';
+const CONTAINER_HOST = 'host.docker.internal';
+const KEYS = ['NANOCLAW_VIMS_ANTHROPIC_URL', 'NANOCLAW_VIMS_GATEWAY_TOKEN'] as const;
+
+export interface VimsGatewaySettings {
+  anthropicUrl: string;
+  token: string;
+}
+
+/** `process.env` wins, then `.env`; both are required. */
+export function readVimsGatewaySettings(env: NodeJS.ProcessEnv = process.env): VimsGatewaySettings {
+  const file = readEnvFile([...KEYS]);
+  const anthropicUrl = (env.NANOCLAW_VIMS_ANTHROPIC_URL || file.NANOCLAW_VIMS_ANTHROPIC_URL || '').trim();
+  const token = (env.NANOCLAW_VIMS_GATEWAY_TOKEN || file.NANOCLAW_VIMS_GATEWAY_TOKEN || '').trim();
+  if (!anthropicUrl || !token) {
+    throw new Error('VIMS gateway requires NANOCLAW_VIMS_ANTHROPIC_URL and NANOCLAW_VIMS_GATEWAY_TOKEN');
+  }
+  return { anthropicUrl, token };
+}
+
+/** The host-side loopback URL VIMS listens on, as an agent container must address it. */
+export function containerAnthropicUrl(hostUrl: string): string {
+  const url = new URL(hostUrl);
+  if (url.hostname === '127.0.0.1' || url.hostname === 'localhost' || url.hostname === '::1') {
+    url.hostname = CONTAINER_HOST;
+  }
+  return url.toString().replace(/\/$/, '');
+}
+
+export function vimsContribution(settings: VimsGatewaySettings): GatewayContribution {
+  return {
+    env: {
+      ANTHROPIC_BASE_URL: containerAnthropicUrl(settings.anthropicUrl),
+      ANTHROPIC_AUTH_TOKEN: settings.token,
+      NO_PROXY: CONTAINER_HOST,
+      no_proxy: CONTAINER_HOST,
+    },
+    networkAccess: { endpoint: CONTAINER_HOST, target: { kind: 'host' } },
+  };
+}
+
+async function ensureSession(input: GatewaySessionInput): Promise<GatewaySessionLease> {
+  const contribution = vimsContribution(readVimsGatewaySettings());
+  log.info('VIMS gateway applied', { agentGroupId: input.key.agentGroupId, sessionId: input.key.sessionId });
+  return { contribution };
+}
+
+function idleUntilAborted(signal: AbortSignal): Promise<void> {
+  if (signal.aborted) return Promise.resolve();
+  return new Promise((resolve) => signal.addEventListener('abort', () => resolve(), { once: true }));
+}
+
+registerGatewayProvider({
+  kind: VIMS_GATEWAY_KIND,
+  agentSkills: [],
+  sessions: { ensure: ensureSession },
+  approvals: { subscribe: (_decide, signal) => idleUntilAborted(signal) },
+});

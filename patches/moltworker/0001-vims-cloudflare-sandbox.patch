+ * Shared-secret auth for machine callers (e.g. a VIMS daemon driving the
+ * sandbox API). Accepts ?token= or an Authorization: Bearer header equal to
+ * MOLTBOT_GATEWAY_TOKEN — the same secret that already controls the sandbox
+ * gateway inside the container.
+ */
+export function hasSharedSecret(c: Context<AppEnv>): boolean {
+  const expected = c.env.MOLTBOT_GATEWAY_TOKEN;
+  if (!expected) return false;
+  const url = new URL(c.req.url);
+  const presented = url.searchParams.get("token") ?? "";
+  if (presented && safeEqual(presented, expected)) return true;
+  const auth = c.req.header("Authorization") ?? "";
+  if (auth.startsWith("Bearer ") && safeEqual(auth.slice(7), expected)) return true;
+  return false;
